# ============================================================
# PID Delta Chat — Environment Variables
# Copy to .env and fill in values. Never commit .env itself.
# ============================================================

# --- Ingest ---
# DPI for PDF page rendering
PID_PDF_DPI=300
# Tesseract language code (for scanned PDFs)
PID_OCR_LANG=eng

# --- Delta ---
# Min fuzzy match score (0-100) for alignment
PID_FUZZY_THRESHOLD=70

# --- Chat / LLM ---
# LLM provider name
PID_LLM_PROVIDER=openai
# Model for chat + embeddings
PID_LLM_MODEL=gpt-4o-mini
# REQUIRED for chat. OpenAI API key (or compatible)
PID_LLM_API_KEY=
# Override API base URL (leave blank for OpenAI default)
PID_LLM_BASE_URL=
PID_EMBEDDING_MODEL=text-embedding-3-small
PID_EMBEDDING_DIM=1536
# Number of retrieval results for RAG
PID_TOP_K=10

# --- Web UI ---
# Bind address (0.0.0.0 for external access)
PID_WEB_HOST=127.0.0.1
# Web server port
PID_WEB_PORT=7860
# Set to "1" to enable public sharing
PID_WEB_SHARE=

# --- Directories ---
# Where to find sample documents
PID_DATA_DIR=data
# Where to write delta reports
PID_OUTPUT_DIR=output

# --- Observability ---
# DEBUG | INFO | WARNING | ERROR
PID_LOG_LEVEL=INFO
# Trace output filename
PID_TRACE_FILE=traces.jsonl
# Langfuse Credentials (leave blank to disable cloud tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
