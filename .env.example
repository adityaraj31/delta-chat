# ============================================================
# PID Delta Chat — Environment Variables
# Copy to .env and fill in values. Never commit .env itself.
# ============================================================

# --- Ingest ---
PID_PDF_DPI=300              # DPI for PDF page rendering
PID_OCR_LANG=eng             # Tesseract language code (for scanned PDFs)

# --- Delta ---
PID_FUZZY_THRESHOLD=70       # Min fuzzy match score (0-100) for alignment

# --- Chat / LLM ---
PID_LLM_PROVIDER=openai      # LLM provider name
PID_LLM_MODEL=gpt-4o-mini    # Model for chat + embeddings
PID_LLM_API_KEY=
# REQUIRED for chat. OpenAI API key (or compatible)
PID_LLM_BASE_URL=            # Override API base URL (leave blank for OpenAI default)
PID_EMBEDDING_MODEL=text-embedding-3-small
PID_EMBEDDING_DIM=1536
PID_TOP_K=10                 # Number of retrieval results for RAG

# --- Web UI ---
PID_WEB_HOST=127.0.0.1       # Bind address (0.0.0.0 for external access)
PID_WEB_PORT=7860            # Gradio server port
PID_WEB_SHARE=               # Set to "1" to create a public gradio.live link

# --- Directories ---
PID_DATA_DIR=data            # Where to find sample documents
PID_OUTPUT_DIR=output        # Where to write delta reports

# --- Observability ---
PID_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR
PID_TRACE_FILE=traces.jsonl  # Trace output filename
